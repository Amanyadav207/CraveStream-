# Copy to .env for local development. Never commit real values.
PORT=3000
NODE_ENV=development
DB_URL=mongodb://127.0.0.1:27017/cravestream
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# Video storage: "s3" (SeaweedFS / MinIO / AWS S3) or "imagekit"
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=cravestream-media
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me

# Only needed when STORAGE_DRIVER=imagekit
IMAGEKIT_PRIVATE_KEY=
